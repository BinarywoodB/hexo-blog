// Remove body top margin
body {
  margin-top: 0 !important;
}

// Prevent embedded PDFs from causing horizontal overflow on mobile.
@media (max-width: 767px) {
  .post-body object,
  .post-body embed {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }
}

// Keep top navigation tabs visually even on desktop.
@media (min-width: 768px) {
  .site-nav .main-menu {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .site-nav .menu-item {
    margin: 0;
    min-width: 86px;
  }

  .site-nav .menu-item a {
    text-align: center;
  }
}
